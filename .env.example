# Memories-Hub configuratie
# Kopieer dit bestand naar .env en pas de waarden aan.
# Het setup.sh script doet dit automatisch met veilige willekeurige waarden.

POSTGRES_DB=memorieshub
POSTGRES_USER=mhub
POSTGRES_PASSWORD=VERVANG_MIJ_MET_STERK_WACHTWOORD
REDIS_PASSWORD=VERVANG_MIJ_MET_STERK_WACHTWOORD
JWT_ACCESS_SECRET=minimaal_64_willekeurige_tekens_hier
JWT_REFRESH_SECRET=andere_64_willekeurige_tekens_hier

# Optioneel
MAX_UPLOAD_SIZE_MB=500
WORKER_CONCURRENCY=2
